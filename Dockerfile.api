# API and simulation image (the `demo` and `api` services of docker-compose.yml).
# SUMO comes from the eclipse-sumo wheel (its Linux binaries link libatomic, X11 and GL even when
# run headless); osmium-tool clips the OSM extract for the city build.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends osmium-tool curl \
    libatomic1 libx11-6 libxext6 libxrender1 libgl1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev --no-install-project
COPY sim ./sim
COPY api ./api
COPY strategist ./strategist
COPY docs ./docs
ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
